{
  "info": {
    "_postman_id": "468e663c-3ba7-45ee-9f3e-957e8b47e01f",
    "name": "Blood Donor Finder - Local API",
    "description": "Ordered end-to-end checks for the lightweight Express backend. Start the server and run all requests in order. The first request creates unique run variables; the final requests remove the three donors and one blood request created by this run. No real communication is sent. If a run is stopped before cleanup, remove its test records using the stored ID variables. O+ query values are URL-encoded as O%2B.\nCanonical API prefix: /api/v1. Records are stored in MongoDB through Mongoose. Backend uses Route -> Controller -> Service -> Model.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Health and initialize this run",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const runId = Date.now().toString() + Math.floor(Math.random() * 10000).toString().padStart(4, '0');",
              "const suffix = runId.slice(-9);",
              "pm.collectionVariables.set('runId', runId);",
              "pm.collectionVariables.set('city', 'Test City ' + runId);",
              "pm.collectionVariables.set('cityLower', ('Test City ' + runId).toLowerCase());",
              "pm.collectionVariables.set('cityQuery', encodeURIComponent(('Test City ' + runId).toLowerCase()));",
              "pm.collectionVariables.set('otherCity', 'Other City ' + runId);",
              "pm.collectionVariables.set('donorPhone', '9' + suffix);",
              "pm.collectionVariables.set('formattedDonorPhone', '9' + suffix.slice(0, 4) + ' ' + suffix.slice(4));",
              "pm.collectionVariables.set('secondPhone', '8' + suffix);",
              "pm.collectionVariables.set('thirdPhone', '7' + suffix);",
              "pm.collectionVariables.set('requesterPhone', '6' + suffix);",
              "['donorId', 'wrongGroupDonorId', 'wrongCityDonorId', 'requestId'].forEach(function (key) { pm.collectionVariables.unset(key); });"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('Success envelope', function () { pm.expect(body.success).to.eql(true); pm.expect(body).to.have.property('data'); });",
              "pm.test('API is healthy', function () { pm.expect(body.data.status).to.eql('ok'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/health",
        "description": "Run this request first. It prepares unique test phones, cities, and variables for the complete workflow. Run the whole collection in order to clean up test records at the end."
      },
      "response": []
    },
