              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "pm.test('Success envelope', function () { pm.expect(body.success).to.eql(true); pm.expect(body).to.have.property('data'); });",
              "pm.test('Donor defaults and normalized group', function () {",
              "  pm.expect(body.data.id).to.be.a('string').and.not.empty;",
              "  pm.expect(body.data.bloodGroup).to.eql('O+');",
              "  pm.expect(body.data.city).to.eql(pm.collectionVariables.get('city'));",
              "  pm.expect(body.data.name).to.eql('Asha Rao');",
              "  pm.expect(body.data.available).to.eql(true);",
              "  pm.expect(body.data.phone).to.eql(pm.collectionVariables.get('donorPhone'));",
              "  pm.expect(body.data.createdAt).to.be.a('string');",
              "  pm.expect(body.data.updatedAt).to.be.a('string');",
              "});",
              "pm.collectionVariables.set('donorId', body.data.id);"
            ]
          }
