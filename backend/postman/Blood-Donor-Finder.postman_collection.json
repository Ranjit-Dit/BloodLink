            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('Success envelope', function () { pm.expect(body.success).to.eql(true); pm.expect(body).to.have.property('data'); });",
              "pm.test('List count matches data', function () { pm.expect(body.data).to.be.an('array'); pm.expect(body.count).to.eql(body.data.length); });",
              "",
              "pm.test('Only the matching donor is returned', function () {",
              "  pm.expect(body.data.map(function (donor) { return donor.id; })).to.eql([pm.collectionVariables.get('donorId')]);",
              "  body.data.forEach(function (donor) { pm.expect(donor.bloodGroup).to.eql('O+'); pm.expect(donor.available).to.eql(true); pm.expect(donor.city.toLowerCase()).to.eql(pm.collectionVariables.get('cityLower')); });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/donors?bloodGroup=O%2B&city={{cityQuery}}&available=true",
